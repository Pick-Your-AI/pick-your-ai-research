{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CD-5 per-stage workload constraint candidate 0.2",
  "description": "Synthetic successor research candidate; typed tokenizer answers and per-stage rejection do not adopt a released contract.",
  "type": "object",
  "required": [
    "x_t0_stage_workload"
  ],
  "additionalProperties": false,
  "properties": {
    "x_t0_stage_workload": {
      "type": "object",
      "required": [
        "proposal_version",
        "build_sha256",
        "answer_states_sha256",
        "inventory_id",
        "stages"
      ],
      "additionalProperties": false,
      "properties": {
        "proposal_version": {
          "const": "cd5-0.2"
        },
        "build_sha256": {
          "$ref": "#/$defs/digest"
        },
        "answer_states_sha256": {
          "$ref": "#/$defs/digest"
        },
        "inventory_id": {
          "$ref": "#/$defs/identity"
        },
        "stages": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/stage"
          }
        }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9]",
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      }
    },
    "digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "not": {
        "pattern": "[^a-f0-9]"
      }
    },
    "reference": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identity"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f\\ud800-\\udfff]"
      }
    },
    "native_units": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "images_per_request",
          "audio_seconds",
          "video_seconds"
        ]
      }
    },
    "stage": {
      "type": "object",
      "required": [
        "id",
        "selection_id",
        "operation",
        "configuration_id",
        "tokenizer_assumption",
        "native_input_units",
        "native_output_units"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identity"
        },
        "selection_id": {
          "$ref": "#/$defs/identity"
        },
        "operation": {
          "$ref": "#/$defs/reference"
        },
        "configuration_id": {
          "$ref": "#/$defs/identity"
        },
        "native_input_units": {
          "$ref": "#/$defs/native_units"
        },
        "native_output_units": {
          "$ref": "#/$defs/native_units"
        },
        "tokenizer_assumption": {
          "$ref": "#/$defs/tokenizer_answer"
        }
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "decimal": {
      "type": "string",
      "maxLength": 38,
      "pattern": "^(?:0|[1-9][0-9]{0,18})(?:\\.[0-9]{1,18})?$",
      "not": {
        "pattern": "[^0-9.]"
      }
    },
    "tokenizer_value": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "basis",
            "reference",
            "assumption"
          ],
          "additionalProperties": false,
          "properties": {
            "basis": {
              "enum": [
                "tokenizer",
                "model"
              ]
            },
            "reference": {
              "$ref": "#/$defs/reference"
            },
            "assumption": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "required": [
            "basis",
            "assumption"
          ],
          "additionalProperties": false,
          "properties": {
            "basis": {
              "const": "model_native"
            },
            "assumption": {
              "const": true
            }
          }
        }
      ]
    },
    "tokenizer_answer": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "provided"
            },
            "value": {
              "$ref": "#/$defs/tokenizer_value"
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "not": {
                "pattern": "[\\ud800-\\udfff]"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "state"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "unknown",
                "missing",
                "withheld",
                "not_applicable"
              ]
            }
          }
        }
      ]
    }
  }
}
