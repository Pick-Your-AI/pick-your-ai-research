{
  "synthetic": true,
  "purpose": "CD-7 projection experiments only; no real evidence or released contract",
  "cases": [
    {
      "id": "M1",
      "extensions": {
        "x_t0_migration_inputs": {
          "components": [
            {
              "id": "model",
              "kind": "model",
              "deployment": {
                "runtime_operator": "provider",
                "capacity": "shared"
              }
            },
            {
              "id": "retrieval",
              "kind": "vector_database",
              "deployment": {
                "runtime_operator": "self",
                "capacity": null
              }
            }
          ]
        }
      },
      "expected": {
        "component_modes": {
          "model": "api",
          "retrieval": "self_hosted"
        },
        "overall_mode": "hybrid"
      }
    },
    {
      "id": "M2",
