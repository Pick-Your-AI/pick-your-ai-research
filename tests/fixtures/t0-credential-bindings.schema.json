{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic CD-6 exact credential source choices",
  "type": "object",
  "required": ["x_t0_credential_bindings"],
  "additionalProperties": false,
  "properties": {
    "x_t0_credential_bindings": {
      "type": "object",
      "required": ["proposal_version", "build_sha256", "revision_locks_sha256", "bindings"],
      "additionalProperties": false,
      "properties": {
        "proposal_version": {"const": "cd6-0.1"},
        "build_sha256": {"$ref": "#/$defs/digest"},
        "revision_locks_sha256": {"$ref": "#/$defs/digest"},
        "bindings": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["selection_id", "source", "auth_method"],
                "additionalProperties": false,
                "properties": {
                  "selection_id": {"$ref": "#/$defs/selection_id"},
                  "source": {"const": "direct"},
                  "auth_method": {"$ref": "#/$defs/authenticated_method"}
                }
              },
              {
                "type": "object",
                "required": ["selection_id", "source", "auth_method", "target_selection_id"],
                "additionalProperties": false,
                "properties": {
                  "selection_id": {"$ref": "#/$defs/selection_id"},
                  "source": {"enum": ["integration", "model_provider"]},
                  "auth_method": {"$ref": "#/$defs/authenticated_method"},
                  "target_selection_id": {"$ref": "#/$defs/selection_id"}
                }
              },
              {
                "type": "object",
                "required": ["selection_id", "source", "auth_method"],
                "additionalProperties": false,
                "properties": {
                  "selection_id": {"$ref": "#/$defs/selection_id"},
                  "source": {"const": "none"},
                  "auth_method": {"const": "none"}
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string", "minLength": 64, "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "selection_id": {
      "type": "string", "minLength": 3, "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_-]{2,79}$",
      "not": {"pattern": "[^a-z0-9_-]"}
    },
    "authenticated_method": {"enum": ["api_key", "oauth2", "service_account", "mTLS"]}
  }
}
