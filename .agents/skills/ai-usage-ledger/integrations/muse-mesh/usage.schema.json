{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Muse usage envelope version 1",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "provider": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "configured_model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "response_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "retry_of": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "schema": {
      "const": "mu-usage/1"
    },
    "invocation_id": {
      "type": "string",
      "format": "uuid"
    },
    "invocation_ordinal": {
      "type": "integer",
      "minimum": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "timestamp_source": {
      "enum": [
        "provider_created",
        "local_request_start"
      ]
    },
    "operation": {
      "enum": [
        "agent",
        "memory",
        "web",
        "unscoped"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "cancelled",
        "interrupted"
      ]
    },
    "http_status": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599
    },
    "usage_source": {
      "enum": [
        "openai_chat_response_usage",
        "unavailable",
        "estimated"
      ]
    },
    "id_mode": {
      "enum": [
        "hmac-sha256",
        "literal"
      ]
    },
    "input_semantics": {
      "enum": [
        "openai-chat",
        "inclusive-cache"
      ]
    },
    "capture_incomplete": {
      "type": "boolean"
    },
    "reported_charge_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000000000.0
    },
    "charge_source": {
      "enum": [
        "gateway_usage_cost",
        null
      ]
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cache_read_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cache_write_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reasoning_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "source_id",
    "provider",
    "configured_model",
    "model",
    "response_id",
    "session_id",
    "run_id",
    "retry_of",
    "schema",
    "invocation_id",
    "invocation_ordinal",
    "started_at",
    "timestamp",
    "timestamp_source",
    "operation",
    "status",
    "http_status",
    "usage_source",
    "id_mode",
    "input_semantics",
    "capture_incomplete",
    "reported_charge_usd",
    "charge_source",
    "input_tokens",
    "output_tokens",
    "total_tokens",
    "cache_read_tokens",
    "cache_write_tokens",
    "reasoning_tokens"
  ],
  "additionalProperties": false
}
