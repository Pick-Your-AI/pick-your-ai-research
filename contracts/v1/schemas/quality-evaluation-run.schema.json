{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "build_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "build_revision": {
      "type": "integer",
      "minimum": 1
    },
    "evaluation_suite_selection_id": {
      "$ref": "common.schema.json#/$defs/selection_id"
    },
    "started_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "finished_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "incomplete"
      ]
    },
    "evaluator_version": {
      "type": "string",
      "minLength": 1
    },
    "dataset_revision": {
      "type": "string",
      "minLength": 1
    },
    "sample_size": {
      "type": "integer",
      "minimum": 1
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "number"
          },
          "threshold": {
            "type": "number"
          },
          "comparator": {
            "type": "string",
            "enum": [
              "gte",
              "gt",
              "lte",
              "lt",
              "eq"
            ]
          },
          "unit": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          }
        },
        "required": [
          "metric",
          "observed",
          "threshold",
          "comparator",
          "passed"
        ]
      },
      "minItems": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "build_id",
    "build_revision",
    "evaluation_suite_selection_id",
    "started_at",
    "finished_at",
    "status",
    "evaluator_version",
    "dataset_revision",
    "sample_size",
    "measurements",
    "artifacts"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-builder.example/v1/quality-evaluation-run.schema.json",
  "title": "Measured quality/safety evaluation evidence, separate from compatibility"
}
