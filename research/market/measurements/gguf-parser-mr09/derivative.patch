new file mode 100644
index 0000000..ac31302
--- /dev/null
+++ b/cmd/mr09-init-estimate/main.go
@@ -0,0 +1,98 @@
+// Experimental project derivative; upstream MIT terms accompany its patch.
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"flag"
+	"fmt"
+	parser "github.com/gpustack/gguf-parser-go"
+	"io"
+	"os"
+	"reflect"
+)
+
+func profile(raw string) (parser.MR09InitBufferProfile, error) {
+	var p parser.MR09InitBufferProfile
+	d := json.NewDecoder(bytes.NewBufferString(raw))
+	token, err := d.Token()
+	if err != nil || token != json.Delim('{') {
+		return p, fmt.Errorf("profile must be one object")
+	}
+	fields := map[string]json.RawMessage{}
+	exact := map[string]bool{}
+	pt := reflect.TypeOf(p)
+	for i := 0; i < pt.NumField(); i++ {
+		exact[pt.Field(i).Tag.Get("json")] = true
+	}
+	for d.More() {
+		token, err = d.Token()
+		if err != nil {
+			return p, err
+		}
+		key, ok := token.(string)
+		if !ok {
+			return p, fmt.Errorf("invalid profile key")
+		}
+		if !exact[key] {
+			return p, fmt.Errorf("unknown or aliased profile field %q", key)
+		}
+		if _, exists := fields[key]; exists {
+			return p, fmt.Errorf("duplicate profile field %q", key)
+		}
+		var value json.RawMessage
+		if err = d.Decode(&value); err != nil {
+			return p, err
+		}
+		fields[key] = value
+	}
+	if _, err = d.Token(); err != nil {
+		return p, err
+	}
+	if _, err = d.Token(); err != io.EOF {
+		return p, fmt.Errorf("profile has trailing content")
+	}
+	b, err := json.Marshal(fields)
+	if err != nil {
+		return p, err
+	}
+	d = json.NewDecoder(bytes.NewReader(b))
+	d.DisallowUnknownFields()
+	err = d.Decode(&p)
+	return p, err
+}
+
+func run() error {
+	pin := flag.String("sha256", "", "independently pinned artifact SHA-256")
+	raw := flag.String("profile", "", "complete explicit MR09 initialization profile JSON")
+	flag.Parse()
+	if flag.NArg() != 0 {
+		return fmt.Errorf("unexpected positional arguments")
+	}
+	p, err := profile(*raw)
+	if err != nil {
+		return err
+	}
+	info, err := os.Stdin.Stat()
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() || info.Size() < 1 || info.Size() > 512*1024*1024 {
+		return fmt.Errorf("stdin must be a nonempty regular GGUF file of at most 512 MiB")
+	}
+	data, err := io.ReadAll(io.LimitReader(os.Stdin, 512*1024*1024+1))
+	if err != nil {
+		return err
+	}
+	result, err := parser.EstimateMR09InitBuffers(data, *pin, p)
+	if err != nil {
+		return err
+	}
+	return json.NewEncoder(os.Stdout).Encode(result)
+}
+func main() {
+	if err := run(); err != nil {
+		json.NewEncoder(os.Stderr).Encode(map[string]string{"error": err.Error()})
+		os.Exit(1)
+	}
+}
